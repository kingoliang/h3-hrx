    %next = scalar.fmaf %weight, %vv, %acc : f32
    scf.yield %next_sum, %next : f32, f32
  }
  %value = scalar.divf %weighted, %total : f32
    view.store %value, %coarse_v[%q, %col] : f32, view<[%blocks]x[%width]xf32>
  kernel.return
}
