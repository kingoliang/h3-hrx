  %sr0 = index.cast %si : i32 to index
  %sr = index.assume %sr0 [range(%sr0, 0, 1048575), lt(%sr0, %padded)] : index
  %b0 = index.div %sr, %c64 : index
  %b = index.assume %b0 [lt(%b0, %blocks)] : index
  scf.for %col0 = [%lane to %width step %c256] {
    %col = index.assume %col0 [lt(%col0, %width)] : index
    %f = view.load %fine_v[%sr, %col] : view<[%padded]x[%width]xf16> -> f16
    %g = view.load %gate_v[%r, %col] : view<[%tokens]x[%width]xf16> -> f16
