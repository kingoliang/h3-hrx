// Native VSA layout, pooling and routing. No token-by-token score allocation.
amdgpu.target<gfx11-generic> @vsa_gfx11 {subgroup_size = 32}
config.decl @h3.vsa.tokens : %value: index where [range(%value, 1, 1048576)]
config.decl @h3.vsa.padded : %value: index where [range(%value, 64, 1048576)]
config.decl @h3.vsa.width : %value: index where [range(%value, 128, 32768)]
config.decl @h3.vsa.blocks : %value: index where [range(%value, 1, 16384)]
config.decl @h3.vsa.heads : %value: index where [range(%value, 1, 256)]
config.decl @h3.vsa.prefix : %value: index where [range(%value, 0, 16384)]
config.decl @h3.vsa.topk : %value: index where [range(%value, 0, 16384)]
kernel.def target(@vsa_gfx11) export("h3_vsa_gather") @h3_vsa_gather(%unused: index) {
  %tokens = config.get @h3.vsa.tokens : index
  %padded = config.get @h3.vsa.padded : index
  %width = config.get @h3.vsa.width : index
  %blocks = config.get @h3.vsa.blocks : index
  %heads = config.get @h3.vsa.heads : index
  %prefix = config.get @h3.vsa.prefix : index
  %topk = config.get @h3.vsa.topk : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %off = index.constant 0 : offset
  %zero = scalar.constant 0.0 : f32
  %one = scalar.constant 1.0 : f32
  %neg = scalar.constant -1000000000.0 : f32
  kernel.launch.config workgroups(%padded, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%unused: index, %src: buffer, %x: buffer, %y: buffer) {
  %tokens = config.get @h3.vsa.tokens : index
  %padded = config.get @h3.vsa.padded : index
  %width = config.get @h3.vsa.width : index
  %blocks = config.get @h3.vsa.blocks : index
  %heads = config.get @h3.vsa.heads : index
  %prefix = config.get @h3.vsa.prefix : index
  %topk = config.get @h3.vsa.topk : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %off = index.constant 0 : offset
  %zero = scalar.constant 0.0 : f32
  %one = scalar.constant 1.0 : f32
  %neg = scalar.constant -1000000000.0 : f32
  %src_g = buffer.assume.memory_space<global> %src : buffer
  %src_v = buffer.view %src_g[%off] : buffer -> view<[%padded]xi32>
  %x_g = buffer.assume.memory_space<global> %x : buffer
  %x_v = buffer.view %x_g[%off] : buffer -> view<[%tokens]x[%width]xf16>
  %y_g = buffer.assume.memory_space<global> %y : buffer
  %y_v = buffer.view %y_g[%off] : buffer -> view<[%padded]x[%width]xf16>
  %r0 = kernel.workgroup.id<x> : index
  %r = index.assume %r0 [lt(%r0, %padded)] : index
  %lane = kernel.workitem.id<x> : index
    %si = view.load %src_v[%r] : view<[%padded]xi32> -> i32
  %sr = index.cast %si : i32 to index
  %live = index.cmp ult, %sr, %tokens : index
  scf.for %col0 = [%lane to %width step %c256] {
    %col = index.assume %col0 [lt(%col0, %width)] : index
    %val = scf.if %live -> (f16) {
      %row = index.assume %sr [lt(%sr, %tokens)] : index
    %v = view.load %x_v[%row, %col] : view<[%tokens]x[%width]xf16> -> f16
      scf.yield %v : f16
    } else {
      %z = scalar.constant 0.0 : f16
      scf.yield %z : f16
    }
    view.store %val, %y_v[%r, %col] : f16, view<[%padded]x[%width]xf16>
  }
  kernel.return
}
