} launch(%unused: index, %inverse: buffer, %fine: buffer, %gate: buffer, %coarse: buffer, %out: buffer) {
  %tokens = config.get @h3.vsa.tokens : index
  %padded = config.get @h3.vsa.padded : index
  %width = config.get @h3.vsa.width : index
  %blocks = config.get @h3.vsa.blocks : index
  %heads = config.get @h3.vsa.heads : index
  %prefix = config.get @h3.vsa.prefix : index
  %topk = config.get @h3.vsa.topk : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %off = index.constant 0 : offset
  %zero = scalar.constant 0.0 : f32
  %one = scalar.constant 1.0 : f32
  %neg = scalar.constant -1000000000.0 : f32
  %inverse_g = buffer.assume.memory_space<global> %inverse : buffer
  %inverse_v = buffer.view %inverse_g[%off] : buffer -> view<[%tokens]xi32>
  %fine_g = buffer.assume.memory_space<global> %fine : buffer
  %fine_v = buffer.view %fine_g[%off] : buffer -> view<[%padded]x[%width]xf16>
  %gate_g = buffer.assume.memory_space<global> %gate : buffer
  %gate_v = buffer.view %gate_g[%off] : buffer -> view<[%tokens]x[%width]xf16>
  %coarse_g = buffer.assume.memory_space<global> %coarse : buffer
  %coarse_v = buffer.view %coarse_g[%off] : buffer -> view<[%blocks]x[%width]xf32>
  %out_g = buffer.assume.memory_space<global> %out : buffer
